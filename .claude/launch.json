{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blazestudio-dev",
      "runtimeExecutable": ".venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["api.index:app", "--reload", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "blazestudio-static",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8002", "--directory", "dist"],
      "port": 8002
    }
  ]
}
